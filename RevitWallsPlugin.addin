<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Only the Application entry is registered. BIMy commands (SetApiToken /
  Disconnect / LoadFromBimy) are surfaced exclusively through the BIMy ribbon
  pulldown built in BimyApplication.OnStartup; registering them here as
  <AddIn Type="Command"> would duplicate every item under Add-Ins → External
  Tools, which is what PM saw.

  Revit resolves each ribbon PushButton's class via the (assemblyPath,
  FullClassName) pair at click time, so commands do NOT need to be declared
  in this manifest for the ribbon to function.
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>BIMy</Name>
    <Assembly>RevitWallsPlugin.dll</Assembly>
    <FullClassName>RevitWallsPlugin.Commands.BimyApplication</FullClassName>
    <ClientId>6f1c2a3e-9b4d-4d8f-9a0c-2f7e6b3a1d10</ClientId>
    <VendorId>RWPL</VendorId>
    <VendorDescription>RevitWallsPlugin BIMy add-in</VendorDescription>
  </AddIn>
</RevitAddIns>
