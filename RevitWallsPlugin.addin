<?xml version="1.0" encoding="utf-8" standalone="no"?>
<RevitAddIns>
  <AddIn Type="Command">
    <Name>Import Walls From URL</Name>
    <Text>Import Walls From URL</Text>
    <Description>Fetches wall definitions from a remote JSON URL and creates native Revit walls.</Description>
    <Assembly>RevitWallsPlugin.dll</Assembly>
    <FullClassName>RevitWallsPlugin.Commands.ImportWallsFromUrlCommand</FullClassName>
    <ClientId>6f1c2a3e-9b4d-4d8f-9a0c-2f7e6b3a1d01</ClientId>
    <VendorId>RWPL</VendorId>
    <VendorDescription>RevitWallsPlugin sample</VendorDescription>
    <VisibilityMode>AlwaysVisible</VisibilityMode>
  </AddIn>
  <AddIn Type="Command">
    <Name>Refresh Walls</Name>
    <Text>Refresh Walls</Text>
    <Description>Re-fetches the last-used URL and re-imports walls.</Description>
    <Assembly>RevitWallsPlugin.dll</Assembly>
    <FullClassName>RevitWallsPlugin.Commands.RefreshWallsCommand</FullClassName>
    <ClientId>6f1c2a3e-9b4d-4d8f-9a0c-2f7e6b3a1d02</ClientId>
    <VendorId>RWPL</VendorId>
    <VendorDescription>RevitWallsPlugin sample</VendorDescription>
    <VisibilityMode>AlwaysVisible</VisibilityMode>
  </AddIn>
</RevitAddIns>
