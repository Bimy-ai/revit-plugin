<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>BimyRevit</AssemblyName>
    <RootNamespace>BimyRevit</RootNamespace>
  </PropertyGroup>

  <!-- Revit install root. Override on the command line with:
       dotnet build /p:RevitVersion=2026 -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitInstallDir>

    <!-- Where RevitAPI.dll comes from. A local Revit install is authoritative
         when there is one; otherwise fall back to the community-published
         reference assemblies on NuGet so the project builds on a machine with
         no Revit — which is every CI runner. Nothing about the produced DLL
         differs between the two: both are reference-only. -->
    <UseLocalRevitApi Condition="'$(UseLocalRevitApi)' == '' And Exists('$(RevitInstallDir)RevitAPI.dll')">true</UseLocalRevitApi>
    <UseLocalRevitApi Condition="'$(UseLocalRevitApi)' == ''">false</UseLocalRevitApi>
    <RevitApiPackageVersion Condition="'$(RevitApiPackageVersion)' == ''">$(RevitVersion).0.0</RevitApiPackageVersion>
  </PropertyGroup>

  <!-- Revit API references. Private/ExcludeAssets keep the assemblies out of
       the output folder either way: Revit hosts us in its own process and
       supplies these at runtime, and shipping a second copy alongside the
       plug-in is how you get assembly-identity conflicts. -->
  <ItemGroup Condition="'$(UseLocalRevitApi)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalRevitApi)' != 'true'">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitApiPackageVersion)"
                      ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProtectedData (DPAPI). Already shipped in the .NET 8 WindowsDesktop runtime that Revit hosts,
         so no DLL is copied to the output - the package reference exists for compile-time resolution. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Ribbon icon. Single PNG source embedded into the DLL (read back at
       runtime via Assembly.GetManifestResourceStream) and reused for both the
       large and small ribbon slots — Revit scales the bitmap for the 16×16
       slot. Replace Resources\bimy-logo.png to change the ribbon logo; also
       re-run Resources\generate-ico.ps1 to keep the installer icon in sync. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\bimy-logo.png" />
  </ItemGroup>

</Project>
