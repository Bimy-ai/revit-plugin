<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Installer-deployed manifest. Only the Application entry is registered; BIMy
  commands live inside the BIMy ribbon pulldown (see BimyApplication.OnStartup)
  so they must NOT be declared here as <AddIn Type="Command"> — Revit would
  otherwise auto-list each one under Add-Ins → External Tools alongside the
  ribbon, producing duplicates.

  <Assembly> stays relative to this file's folder so the install layout is
  fully self-contained — see installer\BIMy.iss for the bundled deployment.
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>BIMy</Name>
    <Assembly>BIMy\BimyRevit.dll</Assembly>
    <FullClassName>BimyRevit.Commands.BimyApplication</FullClassName>
    <ClientId>6f1c2a3e-9b4d-4d8f-9a0c-2f7e6b3a1d10</ClientId>
    <VendorId>BIMY</VendorId>
    <VendorDescription>BIMy.ai — https://bimy.ai</VendorDescription>
  </AddIn>
</RevitAddIns>
