# Shell scripts must have LF endings — CRLF in the shebang makes /usr/bin/env
# look for `bash\r`, which causes Git Bash to hang on fork retries.
*.sh        text eol=lf
install.sh  text eol=lf

# Windows batch / PowerShell expect CRLF.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf
